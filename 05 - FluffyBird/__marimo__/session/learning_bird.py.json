          "data": {
            "text/html": "<span class=\"markdown prose dark:prose-invert\"><h2 id=\"entscheidungen-verarbeiten\">Entscheidungen verarbeiten</h2>\n<span class=\"paragraph\">Lege fest, wie der Vogel auf eine Entscheidung reagieren soll, d.h. wie er mit der Ausgabe des neuronalen Netzes umgehen soll.</span></span>"
          }
        }
      ],
